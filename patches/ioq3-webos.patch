diff --git a/code/sys/sys_main.c b/code/sys/sys_main.c
index e3b63cb5..9d45f32f 100644
--- a/code/sys/sys_main.c
+++ b/code/sys/sys_main.c
@@ -51,6 +51,134 @@ Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA  02110-1301  USA
 #include "../qcommon/q_shared.h"
 #include "../qcommon/qcommon.h"
 
+#ifdef WEBOS
+#include <glob.h>
+#include <unistd.h>
+
+/*
+=================
+Sys_WebOSStart
+
+webOS starts the binary that appinfo.json names as "main" directly, and the luna
+bus only knows the app by that executable: a wrapper script would leave the game
+unable to register, stuck behind the launch spinner. So the setup a wrapper would
+do happens here, before Com_Init:
+- the log goes to /tmp/quake3.log;
+- the remote's Back button reaches the game, as Escape, instead of closing the app;
+- the game data is quake3/baseq3/pak0.pk3 (plus pak1-8) on a USB drive, added as
+  fs_gogpath under the app folder's own baseq3 (the native game modules), with
+  the config, saves and screenshots in quake3/home next to it, so they survive
+  reinstalling the app. Without the drive, the app folder's data/ and home/;
+- with no game data at all, or when launched with {"demo":true}, the Quake III
+  Arena demo that ships in the app folder's demoq3/ (com_basegame demoq3, with
+  its own copy of the native modules, as the demo's QVMs are too old);
+- the first start gets the TV's resolution, vsync, the FPS counter, and the
+  gamepad layout from gamepad.cfg, appended once (marked by .gamepad-N) so later
+  rebinding sticks.
+=================
+*/
+static void Sys_WebOSStart( char *commandLine, int size, qboolean demo )
+{
+	const char *appDir = Sys_BinaryPath( ), *game;
+	char data[ MAX_OSPATH ], home[ MAX_OSPATH ], path[ MAX_OSPATH ], mark[ MAX_OSPATH ];
+	glob_t g;
+	FILE *f, *in;
+
+	if ( freopen( "/tmp/quake3.log", "w", stdout ) )
+		dup2( fileno( stdout ), fileno( stderr ) );
+	setvbuf( stdout, NULL, _IOLBF, 0 );
+
+	setenv( "SDL_WEBOS_ACCESS_POLICY_KEYS_BACK", "true", 1 );
+
+	if ( !demo && glob( "/tmp/usb/*/*/quake3/baseq3/pak0.pk3", 0, NULL, &g ) == 0 && g.gl_pathc > 0 ) {
+		Q_strncpyz( data, g.gl_pathv[ 0 ], sizeof( data ) );
+		*strstr( data, "/baseq3/pak0.pk3" ) = '\0';
+		Com_sprintf( home, sizeof( home ), "%s/home", data );
+		globfree( &g );
+	} else {
+		if ( !demo )
+			globfree( &g );
+		Com_sprintf( data, sizeof( data ), "%s/data", appDir );
+		Com_sprintf( home, sizeof( home ), "%s/home", appDir );
+		Com_sprintf( path, sizeof( path ), "%s/baseq3/pak0.pk3", data );
+		if ( access( path, F_OK ) != 0 )
+			demo = qtrue;
+	}
+	game = demo ? "demoq3" : "baseq3";
+	mkdir( home, 0775 );
+	Com_sprintf( path, sizeof( path ), "%s/%s", home, game );
+	mkdir( path, 0775 );
+
+	Com_sprintf( path, sizeof( path ), "%s/%s/q3config.cfg", home, game );
+	if ( access( path, F_OK ) != 0 && ( f = fopen( path, "w" ) ) ) {
+		fputs( "seta r_mode \"-2\"\nseta r_fullscreen \"1\"\nseta r_swapInterval \"1\"\n"
+			"seta com_maxfps \"60\"\nseta cg_drawFPS \"1\"\n", f );
+		fclose( f );
+	}
+	Com_sprintf( mark, sizeof( mark ), "%s/%s/.gamepad-4", home, game );
+	if ( access( mark, F_OK ) != 0 && ( in = fopen( va( "%s/gamepad.cfg", appDir ), "r" ) ) ) {
+		if ( ( f = fopen( path, "a" ) ) ) {
+			char buf[ 4096 ];
+			size_t n;
+			fputs( "\n", f );
+			while ( ( n = fread( buf, 1, sizeof( buf ), in ) ) > 0 )
+				fwrite( buf, 1, n, f );
+			fclose( f );
+			if ( ( f = fopen( mark, "w" ) ) )
+				fclose( f );
+		}
+		fclose( in );
+	}
+
+	// added once each (marker files), so the menus can change them afterwards:
+	// - mute and slow down while another app is in front, as Home leaves the
+	//   game running;
+	// - the remote's OK (Enter) shoots; its arrows already walk and turn;
+	// - the OpenGL2 renderer's costly extras off, for the Mali-G51 at 1080p
+	Com_sprintf( mark, sizeof( mark ), "%s/%s/.webos-1", home, game );
+	if ( access( mark, F_OK ) != 0 && ( f = fopen( path, "a" ) ) ) {
+		fputs( "\nseta s_muteWhenUnfocused \"1\"\nseta s_muteWhenMinimized \"1\"\n"
+			"seta com_maxfpsUnfocused \"10\"\nseta com_maxfpsMinimized \"5\"\n"
+			"bind ENTER \"+attack\"\n"
+			"seta r_hdr \"0\"\nseta r_postProcess \"0\"\nseta r_toneMap \"0\"\n"
+			"seta r_autoExposure \"0\"\nseta r_sunShadows \"0\"\nseta r_sunlightMode \"0\"\n"
+			"seta r_depthPrepass \"0\"\nseta r_normalMapping \"0\"\n"
+			"seta r_specularMapping \"0\"\nseta r_deluxeMapping \"0\"\n", f );
+		fclose( f );
+		if ( ( f = fopen( mark, "w" ) ) )
+			fclose( f );
+	}
+	// every single-player tier open at every skill: q3_ui reads g_spScores1-5
+	// (one per skill) as \l<level>\<rank>, so mark each level as won. Level 39
+	// is far past the full game's 26.
+	Com_sprintf( mark, sizeof( mark ), "%s/%s/.unlocked-2", home, game );
+	if ( !demo && access( mark, F_OK ) != 0 && ( f = fopen( path, "a" ) ) ) {
+		char scores[ 512 ] = "";
+		int level, skill;
+
+		for ( level = 0; level < 40; level++ )
+			Q_strcat( scores, sizeof( scores ), va( "\\l%d\\1", level ) );
+		fputs( "\n", f );
+		for ( skill = 1; skill <= 5; skill++ )
+			fprintf( f, "seta g_spScores%d \"%s\"\n", skill, scores );
+		fclose( f );
+		if ( ( f = fopen( mark, "w" ) ) )
+			fclose( f );
+	}
+
+	if ( demo ) {
+		printf( "webOS: app %s, the demo, home %s\n", appDir, home );
+		Q_strcat( commandLine, size, "+set com_basegame demoq3 " );
+	} else {
+		printf( "webOS: app %s, data %s, home %s\n", appDir, data, home );
+		Q_strcat( commandLine, size, va( "+set fs_gogpath \"%s\" ", data ) );
+	}
+	Q_strcat( commandLine, size, va( "+set fs_homepath \"%s\" "
+		"+set r_preferOpenGLES 1 +set cl_motd 0 +set sv_pure 0 "
+		"+set vm_ui 0 +set vm_cgame 0 +set vm_game 0 ", home ) );
+}
+#endif
+
 static char binaryPath[ MAX_OSPATH ] = { 0 };
 static char installPath[ MAX_OSPATH ] = { 0 };
 
