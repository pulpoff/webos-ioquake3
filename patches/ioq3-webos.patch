+/*
+===============
+IN_SyncTextInput
+
+Text input only while something takes typing, the console or a chat line: on a phone, text input brings up the
+on-screen keyboard over the game. (The menus' text fields go without it.)
+===============
+*/
+static qboolean textInput = qfalse;
+
+static void IN_SyncTextInput( void )
+{
+	qboolean want = ( Key_GetCatcher( ) & ( KEYCATCH_CONSOLE | KEYCATCH_MESSAGE ) ) != 0;
+
+	if( want == textInput )
+		return;
+
+	if( want )
+		SDL_StartTextInput( );
+	else
+		SDL_StopTextInput( );
+	textInput = want;
+}
