+/*
+===================
+CL_PadMenuKey
+
+A gamepad works the menus the way a console game's do: the D-pad moves, A chooses, B and Back go back. Start is
+Escape everywhere, so it opens the menu in game and leaves it again. The menus know only the keyboard's keys.
+===================
+*/
+static int CL_PadMenuKey( int key ) {
+	if ( key == K_PAD0_START )
+		return K_ESCAPE;
+
+	if ( !( Key_GetCatcher( ) & KEYCATCH_UI ) || ( Key_GetCatcher( ) & KEYCATCH_CONSOLE ) )
+		return key;
+
+	switch ( key ) {
+		case K_PAD0_DPAD_UP:	return K_UPARROW;
+		case K_PAD0_DPAD_DOWN:	return K_DOWNARROW;
+		case K_PAD0_DPAD_LEFT:	return K_LEFTARROW;
+		case K_PAD0_DPAD_RIGHT:	return K_RIGHTARROW;
+		case K_PAD0_A:		return K_ENTER;
+		case K_PAD0_B:
+		case K_PAD0_BACK:	return K_ESCAPE;
+		default:		return key;
+	}
+}
+
 /*
 ===================
 CL_KeyEvent
@@ -1372,6 +1399,19 @@ Called by the system for both key up and key down events
 ===================
 */
 void CL_KeyEvent (int key, qboolean down, unsigned time) {
+	static int padKeyDown[MAX_KEYS];	// what a gamepad button went down as, so it comes up as that too
+
+	if ( key >= K_PAD0_A && key <= K_PAD0_RIGHTTRIGGER ) {
+		if ( down ) {
+			padKeyDown[key] = CL_PadMenuKey( key );
+			key = padKeyDown[key];
+		} else if ( padKeyDown[key] ) {
+			int pressed = padKeyDown[key];
+			padKeyDown[key] = 0;
+			key = pressed;
+		}
+	}
+
 	if( down )
 		CL_KeyDownEvent( key, time );
 	else
